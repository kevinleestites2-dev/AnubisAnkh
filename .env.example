# ── REQUIRED ──────────────────────────────────────────────────────────────
# Gemini API key — get from aistudio.google.com
GOOGLE_AI_STUDIO_API_KEY=your_gemini_api_key

# ── TELEGRAM (daemon alerts + zeus/midas signals) ──────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── NEXUS RELAY (phone control via Railway bridge) ─────────────────────────
NEXUS_RELAY_URL=https://nexus-relay-production.up.railway.app
NEXUS_SECRET=pantheon_prime

# ── STRIPE (war chest revenue tracking) ───────────────────────────────────
STRIPE_SECRET_KEY=sk_live_your_stripe_key

# ── GITHUB (CI status checks) ─────────────────────────────────────────────
GITHUB_TOKEN=ghp_your_github_token

# ── SEARX / VANE (self-hosted search — optional, DDG used as fallback) ─────
# SEARX_URL=http://localhost:3000

# ── ANUBIS DEBUG (verbose ReAct step logging) ─────────────────────────────
# ANUBIS_DEBUG=true
